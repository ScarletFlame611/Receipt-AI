# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Security
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_HASH_SCHEME=argon2

# Database
DATABASE_URL=sqlite:///./data/receipt_ai.db
# DATABASE_URL=postgresql+psycopg2://receipt:receipt@db:5432/receipt_ai

# Uploads
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@receipt-ai.local
EMAIL_BACKEND=console

# Rate limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# Paths to configs
CONFIGS_DIR=./configs